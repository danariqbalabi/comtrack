# Copy this file to .env in the repository root. Defaults work without copying.
APP_NAME=Lomba Radar
APP_ENV=development
# Required together for production; choose a unique password of at least 16 characters.
ACCESS_USERNAME=
ACCESS_PASSWORD=
DATABASE_PATH=data/lomba-radar.db
WORKER_LEASE_SECONDS=90
WORKER_POLL_SECONDS=1
SCHEDULER_POLL_SECONDS=5
# Optional providers: disabled unless explicitly enabled. No paid calls by default.
DISCOVERY_PROVIDER_ENABLED=false
DISCOVERY_PROVIDER=tavily
TAVILY_API_KEY=
# Tavily Free uses Basic Search only, 1 credit/request; keep Pay-as-you-go OFF in your account.
# Daily/monthly credit limits are managed in Settings (default 20/day, 600/month, UTC).
# Brave is retained as an explicit opt-in alternative: DISCOVERY_PROVIDER=brave.
BRAVE_API_KEY=
# Required for manual/scheduled discovery; estimate per request from your provider plan, in USD.
# Reservations are estimates, not a guarantee of the external provider's bill.
BRAVE_COST_PER_REQUEST_USD=
INSTAGRAM_PROVIDER_ENABLED=false
APIFY_TOKEN=
INSTAGRAM_POSTS_LIMIT=5
APIFY_MAX_CHARGE_USD=0.05
OCR_ENABLED=false
TESSERACT_COMMAND=tesseract
OCR_LANGUAGE=eng
# Optional local Ollama only (127.0.0.1:11434); no model is installed/downloaded automatically.
# Start the Ollama server itself with OLLAMA_NO_CLOUD=1; remote model metadata is rejected.
AI_ENABLED=false
AI_MODEL=
# Bump revision whenever local model weights change; invalidates extraction cache.
AI_MODEL_REVISION=1
AI_MAX_REQUESTS_PER_JOB=3
AI_TIMEOUT_SECONDS=45
# Origin browser lokal yang boleh memicu pencarian; pisahkan dengan koma.
API_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8000,http://localhost:8000

# Used by the Vite development server; never sent to the browser.
API_PROXY_TARGET=http://127.0.0.1:8000

# VITE_ variables are public and bundled into frontend code. Never put secrets here.
VITE_API_BASE_URL=/api
