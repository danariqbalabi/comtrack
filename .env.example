# Copy this file to .env in the repository root. Defaults work without copying.
APP_NAME=Lomba Radar
APP_ENV=development
DATABASE_PATH=data/lomba-radar.db
WORKER_LEASE_SECONDS=90
WORKER_POLL_SECONDS=1
# Origin browser lokal yang boleh memicu pencarian; pisahkan dengan koma.
API_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8000,http://localhost:8000

# Used by the Vite development server; never sent to the browser.
API_PROXY_TARGET=http://127.0.0.1:8000

# VITE_ variables are public and bundled into frontend code. Never put secrets here.
VITE_API_BASE_URL=/api
